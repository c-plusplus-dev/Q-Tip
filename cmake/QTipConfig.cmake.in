@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(SDL3 REQUIRED)
find_dependency(SDL3_ttf REQUIRED)
find_dependency(SDL3_image REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/QTipTargets.cmake")

foreach(component IN LISTS QTip_FIND_COMPONENTS)
    if(component STREQUAL "Gamepad")
        set(QTip_Gamepad_FOUND TRUE)
    else()
        set(QTip_${component}_FOUND FALSE)
    endif()
endforeach()

check_required_components(QTip)
